<UserControl x:Class="QuickLook.Plugin.EpubViewer2.EpubViewerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TocItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F0FF"/>
                                <Setter Property="Foreground" Value="#005A9E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="rootGrid" Background="#F9F9F9"
          PreviewKeyDown="RootGrid_PreviewKeyDown"
          KeyDown="RootGrid_KeyDown"
          PreviewMouseWheel="RootGrid_PreviewMouseWheel"
          Focusable="True">
        <!-- 메인 레이아웃: 사이드바 + 콘텐츠 -->
        <Grid x:Name="mainContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="sidebarColumn" Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 사이드바 -->
            <Border x:Name="sidebarPanel" Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <TextBlock Text="목차" FontWeight="SemiBold" FontSize="13" Foreground="#333" VerticalAlignment="Center"/>
                            <Button x:Name="closeTocButton" HorizontalAlignment="Right" Width="22" Height="22"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Content="✕" FontSize="11" Foreground="#888" ToolTip="사이드바 닫기"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="tocListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TocItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="10,8">
                        <TextBlock x:Name="sidebarBookInfo" FontSize="10" Foreground="#888" TextWrapping="Wrap" Text="EPUB"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 우측 콘텐츠: 상단 바 + WebView -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 상단 바: 목차 토글 + 페이지 정보 + 이전/다음 -->
                <Border x:Name="pageInfoBorder" Grid.Row="0" Background="#F5F5F5" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="toggleTocButton" Grid.Column="0" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Content="☰" FontSize="14" Foreground="#333" ToolTip="목차 토글 (Ctrl+Shift+L)"/>
                        <TextBlock x:Name="pageInfoText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="#333" FontSize="12" Text="Cover" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="buttonPrevChapter" Style="{StaticResource NavButtonStyle}" Width="32" Height="28"
                                    Content="‹" FontSize="14" ToolTip="이전 챕터 (←)"/>
                            <Button x:Name="buttonNextChapter" Style="{StaticResource NavButtonStyle}" Width="32" Height="28"
                                    Content="›" FontSize="14" ToolTip="다음 챕터 (→)" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="webViewHost" Grid.Row="1" />

                <TextBlock x:Name="loadingText" Grid.Row="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="13" Text="EPUB 로딩 중..." Visibility="Collapsed" />
            </Grid>

            <GridSplitter Grid.Column="0" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>
        </Grid>
    </Grid>
</UserControl>
